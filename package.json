{
  "name": "asciidoctor-kroki-embedded",
  "version": "0.1.0",
  "description": "Asciidoctor.js extension that emits Kroki-compatible diagrams without contacting a Kroki server.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./antora": "./src/antora.js",
    "./browser": "./src/browser.js",
    "./html": "./src/html.js",
    "./style.css": "./src/style.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "site:dev": "astro dev",
    "site:build": "npm run antora:build && astro build",
    "site:preview": "astro preview",
    "antora:cache": "node scripts/generate-antora-diagram-cache.mjs",
    "antora:build": "node scripts/build-antora-demo.mjs && cd examples/antora-demo && antora generate antora-playbook.yml --clean"
  },
  "peerDependencies": {
    "@asciidoctor/core": ">=4 <5"
  },
  "keywords": [
    "asciidoctor",
    "kroki",
    "diagram",
    "embedded",
    "offline"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@antora/cli": "^3.2.3",
    "@antora/site-generator": "^3.2.3",
    "@asciidoctor/core": "^4.3.0",
    "astro": "^6.4.8",
    "esbuild": "^0.27.7"
  },
  "dependencies": {
    "@plantuml/core": "^1.2026.10",
    "@terrastruct/d2": "^0.1.33",
    "@viz-js/viz": "^3.31.0",
    "bit-field": "^1.11.0",
    "json5": "^2.2.3",
    "lini-wasm": "^1.1.1",
    "mermaid": "^11.17.2",
    "nomnoml": "^1.7.0",
    "pikchr-js": "^0.1.4",
    "vega": "^6.4.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.5.0",
    "wavedrom": "^3.8.0"
  }
}
